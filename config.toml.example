# bdbackup job configuration.
#
# Usage:  bdbackup run -c ~/.config/bdbackup/config.toml -j <job-name> [--dry-run]
#         bdbackup run -c ~/.config/bdbackup/config.toml -j <xtrabackup job> --incremental
#         bdbackup run -c ~/.config/bdbackup/config.toml --validate [-j <job-name>]
#
# All bdbackup settings live under ~/.config/bdbackup/ (honours
# $XDG_CONFIG_HOME and $BDBACKUP_CONFIG_DIR):
#   config.toml          this file — job definitions
#   files.template       file-backup path lists (one path per line)
#   templates/*.py       user-defined exclusion templates (see below)
#   engines/*.py         user-defined database engines (see README "Database engines")
#
# Except for [history], each top-level table is one job; its name is the table name and it must
# set `type`: file | mysqldump | xtrabackup | gfs, or any engine
# registered by a dropped-in module (e.g. a future xtrabackup80 or mysql-shell).
# Any job may set active = false to pause it: `run -j` then refuses it (exit 2)
# and --validate names it as not checked. Schedule jobs with your own crontab
# lines (see the README, "Scheduling"). --validate checks settings/access/grants
# without backups.
# Other keys (except type, active and restore_root) are passed to the backend
# constructor (FileBackup / bdbackup.mysql.MySQLBackup / bdbackup.mysql.XtraBackup),
# so key names use Python-style underscores (e.g. exclude_templates).
# Paths expand ~ and resolve relative to this config file; template/exclude
# entries resolve relative to chdir (or the process working directory).
# A key that doesn't match a constructor/parameter fails the job with a TypeError.
#
# Types must match the constructor: strings for paths, integers for ports,
# booleans for flags, and arrays of strings for the exclusion lists.

# Optional SQLite backup history. Omit this section to disable recording.
# Paths expand ~ and resolve relative to this configuration file.
# Keep the live SQLite database outside paths included in file backups.
[history]
database = "history.sqlite3"
restore_root = "/restore/bdbackup"  # default: ./restores beside this config; jobs may override it

# Every job run records automatically. Browse and recover successful backups:
#   bdbackup history -c config.toml
#   bdbackup history -c config.toml --create-checksum   # checksum older records
#   bdbackup restore -c config.toml
#   bdbackup restore -c config.toml --backup-id 12 --dst /restore/job-12 --yes

# ---------------------------------------------------------------------------
# File backup: tar archive built from a plain-text template of paths.
# ---------------------------------------------------------------------------
[files-daily]
type = "file"

# Template file listing the paths to archive, one per line; blank lines and
# lines starting with '#' are ignored. Keep it with the other settings in
# ~/.config/bdbackup/.
template_filename = "~/.config/bdbackup/files.template"

# Destination archive path WITHOUT extension; the format's extension
# (.tar / .tar.gz / .tar.zst) is appended automatically.
backup_dst = "/backup/files/daily"

# Write daily-<UTC YYYY-MM-DD-HHMMSS>.tar.gz per run instead of replacing
# daily.tar.gz; an existing name is never overwritten (default: false).
# timestamp = true

# Source for file jobs: the source path being backed up. Relative entries
# in the template file, relative `exclude` entries, and relative
# exclusion-template patterns (e.g. "tests/containers/*") are all resolved
# against this directory — never against the process working directory.
# Archive member names are stored relative to it.
chdir = "/srv/www"

# Archive format: "tar", "tar.gz" or "tar.zst".
format = "tar.gz"  # tar.zst requires Python 3.14+

# Follow symbolic links while walking directories (default: false).
follow_symlinks = false

# --- Exclusions ------------------------------------------------------------
# All three mechanisms are optional and MERGE: a path excluded by any of
# them is skipped. They apply to every file found while walking the
# template's directories.

# 1. Exact paths. Absolute entries are used as-is; relative entries resolve
#    against `chdir` (the source path), so "uploads/tmp" below means
#    /srv/www/uploads/tmp. Excluding a directory also excludes everything
#    beneath it.
exclude = ["uploads/tmp", "/srv/www/cache"]

# 2. fnmatch glob patterns. Each pattern is matched against the full resolved
#    path AND against the basename, so "*.log" excludes app.log anywhere.
exclude_pattern = ["*.log", "node_modules"]

# 3. Named exclusion templates: reusable bundles of gitignore-style patterns.
#    Built-in: "python-dev" (__pycache__/, *.pyc, .venv/, venv/, uv.lock,
#    Pipfile.lock, poetry.lock, *.egg-info/, build/, dist/, tool caches...).
#    User-defined presets are self-registering .py files in
#    ~/.config/bdbackup/templates/ (honours $XDG_CONFIG_HOME and
#    $BDBACKUP_CONFIG_DIR) — resolved as the user running the backup, which
#    matters for cron/systemd jobs. Gitignore syntax: trailing "/" matches
#    directories only, a leading "/" anchors to the chdir root, "!" negates.
exclude_templates = ["python-dev"]

# ---------------------------------------------------------------------------
# mysqldump: logical dump of one database (`database`), or of all databases
# (--all-databases in options). Define one job per database to dump several.
# ---------------------------------------------------------------------------
[mysql-dump]
type = "mysqldump"

# Directory the dump file is written into (created if missing).
out_dir = "/backup/mysql/dumps"

user = "backup"                  # MySQL user
# password = "secret"            # keep this file chmod 600 when it holds a password
host = "localhost"
port = 3306

database = "mydatabase"
# mysqldump options as an array of strings.
options = []  # safe defaults include single-transaction, routines, events, triggers

# ---------------------------------------------------------------------------
# xtrabackup/mariabackup: physical backups with retention-based pruning.
# ---------------------------------------------------------------------------
[mysql-prod]
type = "xtrabackup"
# Guided recovery staging root for this job; requires [history].
# restore_root = "/restore/mysql-prod"

# Root directory for this job's backups; dated subdirectories are created
# underneath.
backup_root = "/backup/mysql/production"

# MySQL 8.0/8.4: run the following SQL as a MySQL administrator for local
# XtraBackup connections. Replace the password; skip CREATE USER if it exists.
# These are SQL examples only; bdbackup does not execute these comments.
# CREATE USER 'xtrabackup'@'localhost'
#   IDENTIFIED BY 'REPLACE_WITH_A_STRONG_PASSWORD';
# GRANT BACKUP_ADMIN, PROCESS, RELOAD, LOCK TABLES, REPLICATION CLIENT
#   ON *.* TO 'xtrabackup'@'localhost';
# GRANT SELECT ON performance_schema.log_status
#   TO 'xtrabackup'@'localhost';
# GRANT SELECT ON performance_schema.keyring_component_status
#   TO 'xtrabackup'@'localhost';
# GRANT SELECT ON performance_schema.replication_group_members
#   TO 'xtrabackup'@'localhost';
# SHOW GRANTS FOR 'xtrabackup'@'localhost';
# If using --safe-slave-backup to stop/start replication threads, also run:
# GRANT REPLICATION_SLAVE_ADMIN ON *.* TO 'xtrabackup'@'localhost';
# MySQL 5.7 and MariaDB require different grants. The operating-system user
# running the backup must also have access to MySQL's data files.
# Reference: https://docs.percona.com/percona-xtrabackup/8.4/privileges.html
user = "xtrabackup"
# password = "secret"
binary = "xtrabackup"            # or "mariabackup"
compress = ""                    # off; zstd for compatible XtraBackup, quicklz for MariaDB
compress_threads = 4
parallel = 2                     # copy threads
# throttle = 200                 # optional IOPS limit
# retention_days = 0             # days kept by engine pruning (default 5); 0 disables engine deletion

# Optional AES256 backup encryption (Percona XtraBackup only).
# TOML booleans are true/false, not yes/no. Enabling encryption requires an
# existing, readable key file containing exactly 32 bytes (no trailing newline).
# Create a readable 32-character key once (do not overwrite a key in use):
#   openssl rand -base64 24 | tr -d '\n' > /etc/mysql/xtrabackup.key
#   chmod 600 /etc/mysql/xtrabackup.key
#   stat -c %s /etc/mysql/xtrabackup.key    # must print 32
encrypt = false
# encrypt_key_file = "/etc/mysql/xtrabackup.key"
# Keep the key outside the backup tree and retain it for as long as its backups.
# History records encryption status and the key path, never the key contents.
# Start a new full backup when changing the key or enabling/disabling encryption.

# ---------------------------------------------------------------------------
# GFS: move bdbackup's own backups through a chain of stage directories, using
# only the [history] ledger. Requires [history]. Jobs writing into the first
# stage must set retention_days = 0 (xtrabackup) or timestamp = true (file).
# Every later stage path must contain an empty .bdbackup-destination file.
# After each applying run, every later stage path also receives
# <job>.ledger.sqlite3 (here gfs-main.ledger.sqlite3), a copy of the whole
# history database that restore can use when only a stage survives.
# ---------------------------------------------------------------------------
# Run it after the backups: bdbackup run -c config.toml -j gfs-main
# Add --dry-run to print what would change without changing anything.
[gfs-main]
type = "gfs"

# Stages in chain order. keep is an age from the backup day (Nd, Nw, Nm, Ny)
# and grows along the chain; period thins a stage to the newest backup of each
# week, month or year. The first stage has one path: where backups are written.
[[gfs-main.stage]]
paths = ["/BACKUP"]
period = "daily"
keep = "5d"

[[gfs-main.stage]]
paths = ["/NFS/daily"]           # everything for 15 more days
period = "daily"
keep = "20d"

[[gfs-main.stage]]
paths = ["/NFS/weekly"]          # newest backup of each ISO week
period = "weekly"
keep = "8w"

[[gfs-main.stage]]
paths = ["/NFS/monthly"]         # newest weekly backup of each month
period = "monthly"
keep = "12m"

[[gfs-main.stage]]
paths = ["/NFS/yearly", "/DD/yearly"]   # every path gets a copy
period = "yearly"
keep = "7y"
